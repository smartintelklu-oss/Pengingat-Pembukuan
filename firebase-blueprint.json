{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile and metadata",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Reminder": {
      "title": "Reminder",
      "type": "object",
      "description": "User specific reminder task",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetDateTime": { "type": "string" },
        "priority": { "type": "string" },
        "category": { "type": "string" },
        "isDone": { "type": "boolean" },
        "isSnoozed": { "type": "boolean" },
        "audioNoteUrl": { "type": "string" },
        "recurrence": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "targetDateTime", "priority", "category"]
    },
    "LedgerBook": {
      "title": "LedgerBook",
      "type": "object",
      "description": "User financial ledger book",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "currency": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "currency"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "User financial transaction entry",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "ledgerId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "ledgerId", "type", "amount", "category", "date"]
    },
    "ScheduledWhatsApp": {
      "title": "ScheduledWhatsApp",
      "type": "object",
      "description": "User scheduled WhatsApp message",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "recipientName": { "type": "string" },
        "textType": { "type": "string" },
        "customMessage": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "isSent": { "type": "boolean" },
        "isRecurring": { "type": "boolean" },
        "recurrenceInterval": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "recipientPhone", "recipientName", "textType", "scheduledTime"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "User personal reminders"
    },
    "/users/{userId}/ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/LedgerBook" },
      "description": "User financial ledgers"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User bookkeeping transactions"
    },
    "/users/{userId}/scheduledWhatsApp/{waId}": {
      "schema": { "$ref": "#/entities/ScheduledWhatsApp" },
      "description": "User scheduled WhatsApp messages"
    }
  }
}
